# Server & Environment
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/technova_hardware?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Initial Admin Master Credentials
ADMIN_NAME=Nova Infotech Administrator
ADMIN_EMAIL=zaidm1323@gmail.com
ADMIN_PASSWORD=your_secure_admin_password

# Cloudinary (Media / Product Image Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=technova-hardware

# Razorpay Payment Gateway (Server Handles Order Creation & Verification)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_optional_webhook_secret

# Email SMTP (Verification, Invoices, Reset Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=Demo Infotech <your_email@gmail.com>

# Google Gemini API (AI Assistant Chatbot)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_API_KEY_BACKUP=your_backup_gemini_api_key

# Default Site Settings (Fallback for initial DB seed)
DEFAULT_COMPANY_NAME=Demo Infotech
DEFAULT_PHONE=+91 11 4123 4567
DEFAULT_WHATSAPP=+91 98765 43210
DEFAULT_EMAIL=procurement@demoinfotech.in
DEFAULT_ADDRESS=Unit No. 101, First Floor, Commercial Tower, Barakhamba Road, Connaught Place, New Delhi 110001
